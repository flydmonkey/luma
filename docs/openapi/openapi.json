{
  "openapi": "3.0.3",
  "info": {
    "title": "Luma",
    "version": "1.0.0",
    "description": "Local LAN control API. Every JSON body is { ok, data, error }. Factory host is http://127.0.0.1:12345. Choose a target with PUT /api/v1/target, then POST /session/start. Game capture is closed. Settings cannot change the listen port. Library compress, trim, and repair are jobs."
  },
  "servers": [
    { "url": "/", "description": "This LAN host" },
    { "url": "http://127.0.0.1:12345", "description": "Factory loopback" }
  ],
  "security": [
    { "accessKey": [] },
    { "bearer": [] },
    {}
  ],
  "tags": [
    { "name": "Shell" },
    { "name": "Session" },
    { "name": "Targets" },
    { "name": "Screenshot" },
    { "name": "Settings" },
    { "name": "Library" },
    { "name": "Docs" }
  ],
  "components": {
    "securitySchemes": {
      "accessKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Record-Key",
        "description": "Required on /api/v1, /media, and /poster when an access key is stored. The HTML shell, OpenAPI, and /skill are served without it."
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Same value as X-Record-Key."
      }
    },
    "parameters": {
      "LibraryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "12 hex characters from GET /library property id, or the file name. Comparison is case-insensitive.",
        "schema": { "type": "string" },
        "example": "A1B2C3D4E5F6"
      },
      "TargetKind": {
        "name": "kind",
        "in": "query",
        "required": false,
        "description": "displays (default), windows, games, cameras, microphones, or mics. games is always empty. Any other value lists displays.",
        "schema": { "type": "string" }
      },
      "TargetKindPath": {
        "name": "kind",
        "in": "path",
        "required": true,
        "description": "displays, windows, games, cameras, microphones, or mics. games is always empty. Any other value lists displays.",
        "schema": { "type": "string" }
      },
      "ConfirmDelete": {
        "name": "confirm",
        "in": "query",
        "required": true,
        "description": "Must be true. Any other value returns 400 and 删除需要 confirm=true。",
        "schema": { "type": "string", "enum": ["true"] }
      },
      "WindowIndex": {
        "name": "windowIndex",
        "in": "query",
        "required": false,
        "description": "Index into GET /api/v1/targets/windows, not the window id. When set, the still is that window's pixels.",
        "schema": { "type": "integer", "minimum": 0 }
      },
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["ok", "error"],
        "properties": {
          "ok": { "type": "boolean", "example": false },
          "data": { "nullable": true },
          "error": { "type": "string" }
        }
      },
      "Probe": {
        "type": "object",
        "required": ["name", "control"],
        "properties": {
          "name": { "type": "string", "example": "luma" },
          "control": { "type": "boolean", "example": true }
        }
      },
      "SessionSnapshot": {
        "type": "object",
        "required": ["state", "elapsed"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["idle", "recording", "paused", "stopping"],
            "description": "Countdown is reported as recording."
          },
          "elapsed": { "type": "string", "example": "00:00:00", "description": "hh:mm:ss" },
          "lastSaved": { "$ref": "#/components/schemas/LastSaved" },
          "encoderName": { "type": "string" },
          "actualWidth": { "type": "integer" },
          "actualHeight": { "type": "integer" },
          "stopForced": { "type": "boolean" }
        }
      },
      "LastSaved": {
        "type": "object",
        "nullable": true,
        "properties": {
          "name": { "type": "string", "description": "File name, not a full path." },
          "warning": { "type": "string", "nullable": true }
        }
      },
      "TargetSummary": {
        "type": "object",
        "required": ["mode", "monitorIndex"],
        "properties": {
          "mode": { "type": "string", "enum": ["fullscreen", "region", "window", "audio"] },
          "monitorIndex": { "type": "integer" },
          "region": { "$ref": "#/components/schemas/Region" },
          "windowId": { "type": "string", "nullable": true },
          "windowTitle": { "type": "string", "nullable": true }
        }
      },
      "SessionView": {
        "type": "object",
        "required": ["session", "target"],
        "properties": {
          "session": { "$ref": "#/components/schemas/SessionSnapshot" },
          "target": { "$ref": "#/components/schemas/TargetSummary" }
        }
      },
      "Region": {
        "type": "object",
        "nullable": true,
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      },
      "TargetBody": {
        "type": "object",
        "required": ["mode"],
        "properties": {
          "mode": {
            "type": "string",
            "description": "fullscreen, region, window, or audio. game and 3 are rejected."
          },
          "displayId": { "type": "string", "description": "Monitor index as text. Sets monitorIndex." },
          "windowId": { "type": "string" },
          "windowTitle": { "type": "string" },
          "region": { "$ref": "#/components/schemas/Region" }
        }
      },
      "StartBody": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "description": "Optional guard only. game or 3 is rejected. Any other value does not change the target."
          }
        }
      },
      "TargetItem": {
        "type": "object",
        "required": ["id", "title", "detail"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "preview": {
            "type": "string",
            "nullable": true,
            "description": "data:image/jpeg;base64,... or null."
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "saveFolder": { "type": "string" },
          "lastMode": { "type": "string", "enum": ["Display", "Region", "Window", "Game", "AudioOnly"] },
          "monitorIndex": { "type": "integer" },
          "quality": { "$ref": "#/components/schemas/Quality" },
          "recordingFormat": { "type": "string", "enum": ["mp4", "mkv", "mov", "flv"] },
          "audio": { "$ref": "#/components/schemas/AudioSettings" },
          "overlay": { "type": "object" },
          "hotkeys": { "$ref": "#/components/schemas/Hotkeys" },
          "automation": { "type": "object" },
          "closeToTray": { "type": "boolean" },
          "launchToTray": { "type": "boolean" },
          "hideTrayIcon": { "type": "boolean" },
          "showRecordingBar": { "type": "boolean" },
          "silentMode": { "type": "boolean" },
          "theme": { "type": "string", "enum": ["Light", "Dark"] },
          "uiLanguage": { "type": "string", "example": "system" },
          "resolvedLanguage": { "type": "string", "readOnly": true, "example": "zh-Hans" },
          "lan": { "$ref": "#/components/schemas/LanSettings" }
        }
      },
      "Quality": {
        "type": "object",
        "properties": {
          "level": { "type": "string", "enum": ["Sd", "Hd", "ExtraHd", "FourK"] },
          "frameRate": { "type": "integer" },
          "bitrateKbps": { "type": "integer" },
          "hardwareEncoding": { "type": "boolean" }
        }
      },
      "AudioSettings": {
        "type": "object",
        "properties": {
          "captureSystem": { "type": "boolean" },
          "captureMicrophone": { "type": "boolean" },
          "microphoneDeviceId": { "type": "string", "nullable": true },
          "audioOnly": { "type": "boolean" }
        }
      },
      "Hotkeys": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "start": { "type": "string" },
          "pause": { "type": "string" },
          "stop": { "type": "string" },
          "screenshot": { "type": "string" }
        }
      },
      "LanSettings": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "port": { "type": "integer", "example": 12345 },
          "accessKey": { "type": "string", "description": "Empty, or *** when a key is stored." }
        }
      },
      "SettingsPatch": {
        "type": "object",
        "description": "Only theme, saveFolder, showRecordingBar, silentMode, closeToTray, launchToTray, hideTrayIcon, monitorIndex, lastMode, quality, audio, overlay, hotkeys, automation, uiLanguage, and recordingFormat are applied. lan, lanPort, port, and lanPlayback are rejected. A successful patch clears automation.startAtLogon and automation.schedules.",
        "properties": {
          "theme": { "description": "Light, Dark, 1, or 2." },
          "uiLanguage": {
            "type": "string",
            "enum": ["system", "en", "zh-Hans", "zh-Hant", "ja", "ko"]
          },
          "saveFolder": { "type": "string" },
          "showRecordingBar": { "type": "boolean" },
          "silentMode": { "type": "boolean" },
          "closeToTray": { "type": "boolean" },
          "launchToTray": { "type": "boolean" },
          "hideTrayIcon": { "type": "boolean" },
          "monitorIndex": { "type": "integer" },
          "lastMode": { "type": "string", "enum": ["Display", "Region", "Window", "Game", "AudioOnly"] },
          "quality": { "$ref": "#/components/schemas/Quality" },
          "audio": { "$ref": "#/components/schemas/AudioSettings" },
          "overlay": { "type": "object" },
          "hotkeys": { "$ref": "#/components/schemas/Hotkeys" },
          "automation": { "type": "object" },
          "recordingFormat": { "type": "string", "enum": ["mp4", "mkv", "mov", "flv"] }
        }
      },
      "LibraryItem": {
        "type": "object",
        "required": ["id", "name", "length", "duration", "date", "isAudio"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "length": { "type": "integer", "description": "Size in bytes." },
          "duration": { "type": "string", "example": "00:00:11.8000000" },
          "date": { "type": "string", "format": "date-time" },
          "isAudio": { "type": "boolean" }
        }
      },
      "RenameBody": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        }
      },
      "Deleted": {
        "type": "object",
        "required": ["deleted"],
        "properties": {
          "deleted": { "type": "string" }
        }
      },
      "JobAccepted": {
        "type": "object",
        "required": ["jobId"],
        "properties": {
          "jobId": { "type": "string" }
        }
      },
      "TrimBody": {
        "type": "object",
        "properties": {
          "startSeconds": { "type": "number" },
          "endSeconds": { "type": "number" }
        }
      },
      "Job": {
        "type": "object",
        "required": ["id", "kind", "status"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "status": { "type": "string", "enum": ["running", "done", "error"] },
          "result": { "type": "string", "nullable": true },
          "error": { "type": "string", "nullable": true }
        }
      },
      "ScreenshotRect": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "width": { "type": "integer" },
          "height": { "type": "integer" }
        }
      },
      "ScreenshotWindow": {
        "type": "object",
        "required": ["id", "title", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "width": { "type": "integer" },
          "height": { "type": "integer" }
        }
      },
      "ScreenshotStill": {
        "type": "object",
        "required": ["originX", "originY", "width", "height", "png", "monitors", "windows"],
        "properties": {
          "originX": { "type": "integer" },
          "originY": { "type": "integer" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "png": { "type": "string", "description": "Base64 PNG at host pixel size. Not a data URL." },
          "monitors": { "type": "array", "items": { "$ref": "#/components/schemas/ScreenshotRect" } },
          "windows": { "type": "array", "items": { "$ref": "#/components/schemas/ScreenshotWindow" } }
        }
      },
      "OcrBody": {
        "type": "object",
        "required": ["png"],
        "properties": {
          "png": { "type": "string", "description": "Base64 PNG." }
        }
      },
      "OcrText": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "nullable": true }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Access key missing or wrong.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "ok": false, "data": null, "error": "需要访问密钥。" }
          }
        }
      },
      "NotFound": {
        "description": "Unknown route, missing media file, or missing job.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "ok": false, "data": null, "error": "未找到这个接口。" }
          }
        }
      },
      "BadRequest": {
        "description": "The request was rejected. data is null.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": ["Shell"],
        "summary": "LAN shell",
        "description": "HTML remote panel. When an access key is stored and the request is locked, this returns the unlock form instead of the panel.",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML page.",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/unlock": {
      "post": {
        "tags": ["Shell"],
        "summary": "Unlock the shell",
        "description": "Form body access_key. Used only while the request is still locked. Success sets cookie luma_lan and redirects to /.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": { "access_key": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "302": { "description": "Cookie set. Redirects to /." },
          "200": { "description": "Wrong key. Returns the unlock form again." }
        }
      }
    },
    "/api/v1": {
      "get": {
        "tags": ["Shell"],
        "summary": "Probe",
        "responses": {
          "200": {
            "description": "Server is the Luma control API.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Probe" },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": ["Session"],
        "summary": "Session and target",
        "description": "data.session.state is idle, recording, paused, or stopping. data.target is the current selection.",
        "responses": {
          "200": {
            "description": "Current session and target.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/SessionView" },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/session/start": {
      "post": {
        "tags": ["Session"],
        "summary": "Start the selected target",
        "description": "Uses the target from PUT /api/v1/target. Region needs width and height greater than 0. Window needs windowId. mode game or 3 is rejected. An active session is rejected. data is the session snapshot.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/StartBody" } }
          }
        },
        "responses": {
          "200": {
            "description": "Started. data is the session snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/SessionSnapshot" },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/session/pause": {
      "post": {
        "tags": ["Session"],
        "summary": "Pause or resume",
        "description": "Toggles when state is recording or paused. Idle stays idle and still returns 200.",
        "responses": {
          "200": {
            "description": "Session snapshot after the call.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/SessionSnapshot" },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/session/stop": {
      "post": {
        "tags": ["Session"],
        "summary": "Stop and save",
        "description": "Begins saving and returns the snapshot immediately. Poll GET /api/v1/session until state is idle. lastSaved.name is then the file name. Idle is a no-op.",
        "responses": {
          "200": {
            "description": "Snapshot taken as stop is requested.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/SessionSnapshot" },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/targets": {
      "get": {
        "tags": ["Targets"],
        "summary": "List targets",
        "description": "Lists displays, windows, cameras, or microphones. The list does not select a recording target.",
        "parameters": [{ "$ref": "#/components/parameters/TargetKind" }],
        "responses": {
          "200": {
            "description": "Target array inside data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/TargetItem" } },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/targets/{kind}": {
      "get": {
        "tags": ["Targets"],
        "summary": "List targets by kind",
        "description": "Same items as GET /api/v1/targets. games is always empty.",
        "parameters": [{ "$ref": "#/components/parameters/TargetKindPath" }],
        "responses": {
          "200": {
            "description": "Target array inside data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/TargetItem" } },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/target": {
      "put": {
        "tags": ["Targets"],
        "summary": "Select the recording target",
        "description": "Call this before POST /api/v1/session/start. data is the target summary.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TargetBody" } }
          }
        },
        "responses": {
          "200": {
            "description": "Selected target.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/TargetSummary" },
                    "error": { "nullable": true }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/screenshot": {
      "get": {
        "tags": ["Screenshot"],
        "summary": "Host still",
        "description": "Returns one still of the host virtual desktop at host pixel size, plus monitor and window rectangles in that still. windowIndex, matching GET /targets/windows, returns that window's own pixels instead of the desktop. Does not write a PNG, change the clipboard, or start, pause, or stop a recording. The browser crops, saves, and copies locally.",
        "parameters": [{ "$ref": "#/components/parameters/WindowIndex" }],
        "responses": {
          "200": {
            "description": "Still payload. data.png is the full host-pixel PNG.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "data"],
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/ScreenshotStill" },
                    "error": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No display or window could be captured.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "ok": false, "data": null, "error": "没有可截取的显示器。" }
              }
            }
          },
          "401": {
            "description": "Access key is stored and the client is not unlocked. No screen pixels are returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" },
                "example": { "ok": false, "data": null, "error": "需要访问密钥。" }
              }
            }
          }
        }
      }
    },
    "/api/v1/screenshot/ocr": {
      "post": {
        "tags": ["Screenshot"],
        "summary": "Read text from a still",
        "description": "Body png is base64. An empty image is rejected. data.text may be null.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OcrBody" } }
          }
        },
        "responses": {
          "200": {
            "description": "Recognized text.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
